# Cloudflare Pages routing config.
# Next.js static export with [id] dynamic segments only generates HTML for the
# IDs declared in generateStaticParams() (a single 'placeholder' entry).
# Any real runtime ID navigated to (router.push or direct URL) needs to fall
# back to the placeholder HTML so the client can read useParams() and fetch
# the actual data. The 200 status code = rewrite (server returns placeholder
# HTML but URL keeps the real ID in the browser).

# QA runs detail
/dashboard/admin/qa/*  /dashboard/admin/qa/placeholder/index.html  200

# Pulse node detail
/dashboard/admin/pulse/node/*  /dashboard/admin/pulse/node/placeholder/index.html  200

# Runtics runs detail
/dashboard/runtics/runs/*  /dashboard/runtics/runs/placeholder/index.html  200

# Runtics agents detail
/dashboard/runtics/agents/*  /dashboard/runtics/agents/placeholder/index.html  200
